{
  "name": "local-llm-monitor",
  "version": "1.0.0",
  "description": "Zero-dependency terminal UI for monitoring a local vLLM or Ollama server (+ NVIDIA GPU): GPU utilization, VRAM, model placement, request queue, KV/prefix cache, and token throughput.",
  "type": "module",
  "bin": {
    "llm-monitor": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "ollama": "node src/index.js --platform ollama",
    "vllm": "node src/index.js --platform vllm",
    "plain": "node src/index.js --plain",
    "once": "node src/index.js --once",
    "once:ollama": "node src/index.js --platform ollama --once",
    "once:vllm": "node src/index.js --platform vllm --once"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
